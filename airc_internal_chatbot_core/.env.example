# =================================
# IT Faculty Advisor Core - Environment Variables
# =================================

# App
APP_NAME="IT Faculty Advisor Core"
DEBUG=true

# Postgres
DATABASE_URL=postgresql+asyncpg://it_admin:it_chatbot_2026@localhost:5432/it_student_chatbot

# Redis (for background jobs)
REDIS_URL=redis://localhost:6379/0

# Qdrant (Vector Database)
QDRANT_URL=http://localhost:6333

# JWT (for token verification - must match Auth Service)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Auth Service
AUTH_SERVICE_URL=http://localhost:8001

# Gemini LLM
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=models/gemini-2.5-flash

# Upload
MAX_UPLOAD_SIZE=209715200
