flowchart LR
    %% ==========================================
    %% CÁC TÁC NHÂN HỆ THỐNG (ACTORS - CHUẨN UML KHÔNG DÙNG ICON)
    %% ==========================================
    SV["Sinh viên (Student)"]

    %% ==========================================
    %% RANH GIỚI HỆ THỐNG (SYSTEM BOUNDARY)
    %% ==========================================
    subgraph SYSTEM ["HỆ THỐNG CỐ VẤN HỌC TẬP KHOA CNTT"]
        %% Nhóm ca sử dụng Sinh viên & Chung
        UC1(["Đăng nhập & Xác thực"])
        UC2(["Hỏi đáp tư vấn học vụ"])
        UC3(["Giao tiếp giọng nói Live Voice"])
        UC4(["Tra cứu môn đủ điều kiện"])
        UC5(["Xem cây tiên quyết DAG"])
        UC6(["Tra cứu kết quả học tập"])
        UC7(["Tìm kiếm & Tải tài liệu PDF"])

        %% Nhóm ca sử dụng Giảng viên / Cố vấn
        UC8(["Theo dõi tiến độ học tập lớp"])
        UC9(["Quản lý học liệu & Đóng góp"])
        UC10(["Hỏi đáp trợ lý chuyên môn AI"])

        %% Nhóm ca sử dụng Quản trị viên
        UC11(["Quản trị người dùng & RBAC"])
        UC12(["Quản lý 23 môn & Cây tiên quyết"])
        UC13(["Nhập & Cập nhật điểm thi"])
        UC14(["Quản trị kho tri thức & LLM"])
    end

    %% Tác nhân phía bên phải
    GV["Giảng viên / Cố vấn (Teacher)"]
    AD["Quản trị viên (Admin)"]

    %% Quan hệ UML phụ thuộc include và extend
    UC2 -.->|extend| UC3
    UC4 -.->|include| UC5
    UC2 -.->|include| UC1

    %% Kết nối Actor Sinh viên (bên trái nối vào)
    SV --- UC1
    SV --- UC2
    SV --- UC4
    SV --- UC6
    SV --- UC7

    %% Kết nối Actor Giảng viên (bên phải trên nối vào)
    UC5 --- GV
    UC8 --- GV
    UC9 --- GV
    UC10 --- GV

    %% Kết nối Actor Quản trị viên (bên phải dưới nối vào)
    UC11 --- AD
    UC12 --- AD
    UC13 --- AD
    UC14 --- AD

    %% Định vị GV ở trên và AD ở dưới bên phải
    GV ~~~ AD

    %% Định dạng trực quan chuẩn UML
    style SYSTEM fill:#FAFAFA,stroke:#334155,stroke-width:2px;
    classDef actorStyle fill:#EBF8FF,stroke:#1D4ED8,stroke-width:2px,font-weight:bold,color:#1E293B;
    classDef ucStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A;
    class SV,GV,AD actorStyle;
    class UC1,UC2,UC3,UC4,UC5,UC6,UC7,UC8,UC9,UC10,UC11,UC12,UC13,UC14 ucStyle;
